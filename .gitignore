# Build / release artifacts — these are published via GitHub Releases, never
# committed (they bloat the repo: a single appliance ISO is ~1.8 GB).
*.iso
*.deb
hifi-install-*.sh
hifi-os-*.tar.gz
hifi-system-*.tar.gz
hifi-ui-*.tar.gz

.abacusai/

# F-Droid self-hosted repo: signing keystore and generated index/APKs are
# never committed. The keystore only exists as a GitHub Actions secret; the
# repo/ dir + index are built in CI and published straight to gh-pages.
fdroid/keystore.p12
fdroid/repo/
fdroid/archive/
fdroid/tmp/
fdroid/logs/
fdroid/stats/
fdroid/unsigned/

# Local-only copy of Lyrion Media Server sources, kept for reference/analysis
# — not part of this repo, never committed.
lyrion/

# Email <-> GitHub Issues support bot: runs standalone on a cloud VM, not
# part of this app. The script itself + its secrets/state stay local-only.
support_bot.py
support_bot.service
support_bot.env
support_bot_state.db
support_bot_state.db-wal
support_bot_state.db-shm
.env

android-companion/buildSrc/build/libs/*.jar

# Local-only personal cheat sheet for manual git/deploy steps — never
# committed, so it can freely mention internal workflow details.
DEPLOY-CHEATSHEET.html

# Design working files (Photoshop sources and their exports, zipped): they are
# the artwork's editing history, not something the build consumes — only the
# exported assets under assets/ are.
statusbarflat.zip
