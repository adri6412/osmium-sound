node_modules/
dist/
renderer-dist/
*.log
.DS_Store
.vscode/
.idea/
.claude/
__pycache__/
*.pyc

# Build / release artifacts — these are published via GitHub Releases, never
# committed (they bloat the repo: a single appliance ISO is ~1.8 GB).
*.iso
*.deb
hifi-install-*.sh
hifi-os-*.tar.gz
hifi-system-*.tar.gz
hifi-ui-*.tar.gz

.abacusai/

# Device GitHub PAT for the remote-support key-mint workflow — materialized
# here only during the release build (build-ui-ota.yml, from the
# HIFI_DEVICE_PAT secret), never committed. See
# distro/os-update/apply.d/0030-remote-support-github.sh.
distro/os-update/files/github-support-pat.txt

# F-Droid self-hosted repo: signing keystore and generated index/APKs are
# never committed. The keystore only exists as a GitHub Actions secret; the
# repo/ dir + index are built in CI and published straight to gh-pages.
fdroid/keystore.p12
fdroid/repo/
fdroid/archive/
fdroid/tmp/
fdroid/logs/
fdroid/stats/
fdroid/unsigned/
