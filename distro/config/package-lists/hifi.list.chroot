# ── HiFi Player appliance — package list ──────────────────────────
# IMPORTANT: one package per line, NO inline comments. live-build passes
# whole lines to apt, so a trailing "# ... a/b/c" becomes a bogus argument.

# Kernel
linux-image-amd64

# UEFI Secure Boot — the signed boot chain (all in Debian 'main', amd64):
#   shim-signed (Microsoft-signed) → grub-efi-amd64-signed (Debian-signed) →
#   the already-signed linux-image-amd64. Shipping these in the live filesystem
#   means the installer (which clones the live system) lands them on the target,
#   and grub-installer sets up the shim chain on UEFI installs. The box then
#   boots with UEFI Secure Boot enabled in firmware — verified at build time, the
#   ONLY safe place to touch the bootloader (NOT via OTA — see
#   distro/os-update/apply.d/0010-secure-boot.sh, kept as a no-op).
# BIOS/legacy boot — the partition layout (see includes.installer/preseed.cfg)
# always carved out a 1MB bios_grub partition for this, but the package that
# actually populates it was missing, so grub-installer had nothing to install
# on a BIOS-booted target and the install failed. Shipping it here (like the
# UEFI chain above) lands it on the target via the live-clone install, so
# grub-installer can run grub-install --target=i386-pc fully offline. Debian
# permits grub-pc and grub-efi-amd64-signed installed side by side; d-i's
# grub-installer picks the right one for the machine's actual boot mode.
grub-efi-amd64-signed
shim-signed
efibootmgr

# Firmware — broad coverage for all mainline-supported WiFi/Ethernet/etc.
# (requires the non-free-firmware archive area, set in build-distro.sh).
# MediaTek MT76xx firmware ships inside firmware-misc-nonfree on bookworm.
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-libertas
firmware-ti-connectivity
firmware-zd1211
wireless-regdb
wpasupplicant

# Xorg + minimal display stack (no desktop environment)
xserver-xorg-core
xserver-xorg-video-all
xserver-xorg-input-all
x11-xserver-utils
xinit
lightdm
unclutter
# Compositor Wayland della sessione kiosk (vedi os-update/files/kiosk-wayland-*):
# la finestra a schermo intero va in scanout diretto, cosa che su X11 non
# succede quando è attiva la scalatura del framebuffer. wlr-randr è il modo in
# cui hifi-ui-resolution.sh / hifi-ui-refresh.sh configurano l'output sul
# backend Wayland; xwayland serve ai pochi client X rimasti (tastiera virtuale).
labwc
wlr-randr
xwayland

# Fonts — the base image shipped none, so album/track names in Japanese (and
# Chinese/Korean) rendered as tofu boxes. Noto CJK supplies those glyphs;
# DejaVu is a reliable Latin/Cyrillic/Greek base for the UI font stack.
fonts-noto-cjk
fonts-dejavu-core

# Electron runtime libraries
libgtk-3-0
libnss3
libxss1
libxtst6
libatk-bridge2.0-0
libatk1.0-0
libcups2
libgbm1
libdrm2
libasound2
libnotify4
libxkbcommon0
xdg-utils

# Audio
alsa-utils

# Audio CD support (Lyrion "CD Player" plugin reads the optical drive via these)
cdparanoia
libcdio-utils
icedax

# CD ripping to library (hifi-rip-cd.py: encode + tag + TOC lookup + eject)
flac
cd-discid
eject

# Lyrion Music Server transcoding helpers (convert.conf shells out to these;
# it does NOT reuse squeezelite's playback libraries). Without them, Lyrion
# can only pass formats through untouched — in practice only FLAC played.
lame
faad
sox
wavpack
ffmpeg

# Squeezelite (Debian build has VISEXPORT; -v exports /dev/shm/squeezelite-*)
squeezelite

# NOTE: network audio receivers (AirPlay, UPnP/DLNA, Spotify Connect) are NOT
# system packages — they are Lyrion plugins (ShairTunes2 / UPnP-DLNA / Spotty)
# that route through Lyrion/squeezelite. Installed one-click from the Lyrion web
# UI → Settings → Plugins (the device has internet). This avoids extra ALSA
# contention and keeps a single audio path.

# Python services (api_server.py + vu_meter_daemon.py + sources_server.py)
python3
python3-flask
python3-flask-cors
python3-psutil
python3-websockets
python3-yaml
# numpy: vectorised RMS for the VU meter (vu_meter_daemon.py). The daemon falls
# back to pure Python if it's ever missing, but installing it keeps playback CPU
# low on the mini-PC.
python3-numpy

# Network shares (SMB mounting for music sources + serving internal disks)
cifs-utils
samba
exfatprogs

# hifi-disk-install.sh (the Electron installer's backend): unsquashfs
# copies the live filesystem onto the target disk, mkfs.vfat formats the
# EFI System Partition. sfdisk/mkfs.ext4 come from util-linux/e2fsprogs,
# already part of the base system.
squashfs-tools
dosfstools

# mDNS/Bonjour discovery (also installed via OTA 0016 on existing systems, but
# fresh ISOs should ship it too so \\hifiplayer.local resolves out of the box)
avahi-daemon

# Lyrion Music Server runtime dependencies (the .deb is installed via hook 0050)
perl
libio-socket-ssl-perl
libcrypt-openssl-rsa-perl
psmisc
procps

# Boot splash (hidden/branded boot)
plymouth
plymouth-themes

# System / networking
sudo
openssh-server
curl
ca-certificates
openssl
isc-dhcp-client
iproute2
network-manager
# dnsmasq-base is required by NetworkManager's ipv4.method=shared (the first-boot
# setup Wi-Fi hotspot / captive portal). Not pulled in automatically because the
# image is built --apt-recommends false.
dnsmasq-base
locales

# Automatic security updates (config in /etc/apt/apt.conf.d/52hifi-unattended).
# The appliance is internet-connected, so unpatched Debian security holes are a
# real risk; this keeps the base OS patched without manual intervention.
unattended-upgrades

# Rotates /var/log/hifi/*.log (config in /etc/logrotate.d/hifi) — the custom
# daemons/scripts write there now (see hifi_logging.py / hifi-log.sh) so the
# support-bundle endpoint has persistent history, without ever growing unbounded.
logrotate

# intel_gpu_top — Intel iGPU busy% for the admin dashboard's system stats
# tile (api_server.py get_system_stats). Not pulled in by anything else.
intel-gpu-tools

# radeontop — AMD/ATI GPU busy% counterpart to intel-gpu-tools, same two
# call sites. Not pulled in by anything else.
radeontop

# lspci — GPU model string for both the admin dashboard and the beta-testing
# telemetry snapshot (hifi-beta-agent.py gpu_model()). Not pulled in by
# anything else, and not part of a minimal Debian base.
pciutils
