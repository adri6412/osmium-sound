#!/bin/sh
# HiFi Player appliance — install Tailscale (via the official install script,
# which sets up its own repo/signing key) + `age` (used to decrypt the
# minted remote-support key, see api_server.py's _fetch_minted_key) + a
# dedicated 'support' system user, so the "remote support" toggle in
# Settings (webui_server.py → api_server.py's set_remote_support) works
# immediately on a fresh install, without relying on a runtime apt install
# from the web UI. See distro/os-update/apply.d/0029-remote-support.sh and
# 0030-remote-support-github.sh for the equivalent migrations on
# already-installed devices — keep all in sync.
set -e

echo "I: [hifi] installing Tailscale"
curl -fsSL https://tailscale.com/install.sh | sh

echo "I: [hifi] installing age (remote-support key decryption)"
apt-get install -y age

echo "I: [hifi] creating dedicated 'support' system user for remote-support SSH sessions"
if ! id support >/dev/null 2>&1; then
    useradd --system --create-home --shell /bin/bash \
        --groups adm,systemd-journal support
    passwd -l support >/dev/null 2>&1 || true
fi

echo "I: [hifi] remote-support hook done"
