#!/bin/sh
# HiFi Player appliance — create kiosk user, X session, hostname.
set -e

echo "I: [hifi] creating kiosk user 'hifi'"
# Groups required for LightDM passwordless autologin on Debian
groupadd -f autologin
groupadd -f nopasswdlogin
# NOTE: 'hifi' is deliberately NOT in the 'sudo' group, and ships with NO
# password at all. Nothing on this image authenticates it by password: LightDM
# autologins via the autologin/nopasswdlogin groups, and the appliance's own
# privileged calls go through the specific NOPASSWD commands whitelisted in
# /etc/sudoers.d/hifi. The image therefore carries no known credential — the
# SSH/console login is created from the admin account in the provisioning
# wizard (api_server.py set_shell_account), which gives it real sudo.
# This also covers the installed system: hifi-disk-install.sh copies the
# live filesystem onto the target disk (unsquashfs), so this shadow entry is
# what lands on disk.
if ! id hifi >/dev/null 2>&1; then
    useradd -m -G audio,video,plugdev,netdev,autologin,nopasswdlogin -s /bin/bash hifi
fi
# '*' means "no valid hash", unlike `passwd -l`, which only prefixes '!' to an
# existing (guessable) one. Applied unconditionally so a rebuild over an older
# chroot cache can't leave the historical hifi:hifi default in place.
usermod -p '*' hifi
# Ensure autologin groups even if the user already existed, and make sure the
# account is not left in 'sudo' from an earlier build.
usermod -aG autologin,nopasswdlogin hifi || true
gpasswd -d hifi sudo 2>/dev/null || true

echo "I: [hifi] finalising kiosk X session for user 'hifi'"
# includes.chroot creates /home/hifi before useradd runs, so the directory is
# initially owned by root. useradd -m leaves existing directories untouched.
# Fix ownership here so hifi can write .Xauthority/.ICEauthority at login time.
chown hifi:hifi /home/hifi

# The .xsession is the SINGLE SOURCE OF TRUTH at distro/os-update/files/xsession,
# injected into this image by build-distro.sh and installed identically by the
# OS-update OTA (apply.d/0001-selfhealing-xsession.sh). Here we only fix the
# ownership/mode now that the 'hifi' user exists — we do NOT write the content,
# so the live session and the OTA can never drift.
if [ -f /home/hifi/.xsession ]; then
    chmod +x /home/hifi/.xsession
    chown hifi:hifi /home/hifi/.xsession
else
    echo "W: [hifi] /home/hifi/.xsession missing — did build-distro.sh inject it?" >&2
fi

echo "I: [hifi] setting hostname"
echo "hifiplayer" > /etc/hostname
# /etc/hosts needs a matching entry (Debian convention: 127.0.1.1) or every
# sudo invocation on the box prints "unable to resolve host hifiplayer" —
# cosmetic on its own, but noisy in every log and every error message that
# surfaces a command's stderr to the UI (e.g. Settings -> SSH). Observed on
# real devices with a COMPLETELY EMPTY /etc/hosts (not even 127.0.0.1
# localhost) — live-build's own chroot/binary pipeline appears to leave the
# file empty at build time because bootappend-live carries `hostname=`, which
# is meant for live-config's runtime hostname component; that component never
# runs on a disk-installed boot (no `boot=live`), so nothing ever fills the
# file in on a real device. Don't assume either line pre-exists — grep-guard
# each independently, so this hook stays idempotent if it's ever re-run.
grep -q '^127\.0\.0\.1[[:space:]]' /etc/hosts 2>/dev/null || echo "127.0.0.1	localhost" >> /etc/hosts
grep -q '^127\.0\.1\.1[[:space:]]' /etc/hosts 2>/dev/null || echo "127.0.1.1	hifiplayer" >> /etc/hosts

echo "I: [hifi] system setup hook done"
