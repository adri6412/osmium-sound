#!/bin/sh
# HiFi Player — brand the ISO boot menus and fix kernel/initrd paths.
#
# Runs during live-build's *binary* stage (cwd = binary/), AFTER isolinux and
# grub menus have been generated.
#
# There is no debian-installer on this image — it's a live-only ISO. Both
# boot menu entries below boot the SAME live kernel/initrd/squashfs; they
# differ only by a kernel parameter (hifi.installer=1) that the Electron app
# reads at startup (see src/App.jsx) to decide whether to show the installer
# UI (disk picker → hifi-disk-install.sh) or the normal kiosk UI. The
# actual live kernel/initrd path varies by live-build version/arch, so we
# autodetect it rather than hardcoding (hardcoding it previously broke
# booting with "vmlinuz not found").
set -e

echo "I: [hifi] branding boot menus (binary hook)"

# ─────────── locate the live kernel + initrd on the ISO ────────────
LKPATH="$(find . -maxdepth 2 -type f \( -name 'vmlinuz' -o -name 'vmlinuz.*' -o -name 'linux' \) \
            -path '*live*' 2>/dev/null | head -n1 || true)"
if [ -z "$LKPATH" ]; then
    echo "E: [hifi] no live vmlinuz found — leaving boot menus untouched" >&2
    exit 0
fi
LKDIR="$(dirname "$LKPATH")"
LIPATH="$(find "$LKDIR" -maxdepth 1 -type f \( -name 'initrd.img' -o -name 'initrd.gz' -o -name 'initrd' \) 2>/dev/null | head -n1 || true)"
[ -n "$LIPATH" ] || { echo "E: [hifi] no live initrd found next to $LKPATH" >&2; exit 0; }

LIVE_KERNEL="$(printf '%s' "$LKPATH" | sed 's|^\.||')"
LIVE_INITRD="$(printf '%s' "$LIPATH" | sed 's|^\.||')"
echo "I: [hifi] live kernel=$LIVE_KERNEL initrd=$LIVE_INITRD"

# NOTE: keep LIVE_APPEND in sync with --bootappend-live in build-distro.sh's
# lb config call. INSTALL_APPEND is the same plus hifi.installer=1.
LIVE_APPEND="boot=live components quiet splash loglevel=0 vt.global_cursor_default=0 hostname=hifiplayer noautologin"
INSTALL_APPEND="$LIVE_APPEND hifi.installer=1"

# ─────────────────────────── isolinux / BIOS ───────────────────────
if [ -d isolinux ]; then
    cat > isolinux/menu.cfg <<EOF
menu title Osmium Sound
menu background splash.png
menu color title       1;37;40   #ffd4af37 #00000000 std
menu color sel         7;37;40   #ff000000 #ffd4af37 all
menu color unsel       37;40     #ffd4af37 #00000000 std
menu color hotkey      1;37;40   #ffffffff #00000000 std
menu color hotsel      1;7;37;40 #ff000000 #ffd4af37 all
menu color border      30;44     #00000000 #00000000 std
menu color scrollbar   30;44     #ffd4af37 #00000000 std
menu color tabmsg      31;40     #ff888888 #00000000 std
menu color timeout_msg 37;40     #ff888888 #00000000 std
menu color timeout     1;37;40   #ffd4af37 #00000000 std
menu vshift 12
menu rows 4
menu timeoutrow 14

label install
    menu label ^Install Osmium Sound
    menu default
    kernel $LIVE_KERNEL
    append initrd=$LIVE_INITRD $INSTALL_APPEND

label live
    menu label ^Try Osmium Sound (no install)
    kernel $LIVE_KERNEL
    append initrd=$LIVE_INITRD $LIVE_APPEND
EOF

    cat > isolinux/isolinux.cfg <<'EOF'
include menu.cfg
prompt 0
timeout 50
ui vesamenu.c32
default install
EOF
    # Some live-build layouts read stdmenu.cfg; neutralise it so only our
    # two entries show.
    : > isolinux/stdmenu.cfg 2>/dev/null || true
fi

# ─────────────────────────── grub / UEFI ───────────────────────────
for gcfg in boot/grub/grub.cfg EFI/debian/grub.cfg; do
    [ -f "$gcfg" ] || continue
    cat > "$gcfg" <<EOF
if loadfont /boot/grub/font.pf2 ; then
    set gfxmode=640x480
    insmod efi_gop
    insmod efi_uga
    insmod video_bochs
    insmod video_cirrus
    insmod gfxterm
    insmod png
    terminal_output gfxterm
fi

background_image /boot/grub/splash.png
set menu_color_normal=light-gray/black
set menu_color_highlight=black/yellow
set timeout=5
set default=0

menuentry "Install Osmium Sound" {
    linux  $LIVE_KERNEL $INSTALL_APPEND
    initrd $LIVE_INITRD
}

menuentry "Try Osmium Sound (no install)" {
    linux  $LIVE_KERNEL $LIVE_APPEND
    initrd $LIVE_INITRD
}
EOF
done

echo "I: [hifi] boot branding done"
