#!/bin/sh
# HiFi Player appliance — finalise the on-screen interface installed under /opt
# and the executable bits of the services, which live-build copies as git
# records them (this repo has core.filemode=false).
set -e

QTDIR=/opt/hifi-qt

# 🚨 The interface is the Qt one, and it must be there: an image without a
# program to start would be a black screen. (The Electron app was removed
# from the repository on 2026-10-02; nothing injects it any more.)
if [ ! -f "$QTDIR/hifi-qt" ]; then
    echo "E: [hifi] $QTDIR/hifi-qt not found — the Qt interface payload was not injected. Aborting." >&2
    exit 1
fi

echo "I: [hifi] ensuring python services are executable"
chmod +x /usr/local/bin/vu_meter_daemon.py /usr/local/bin/api_server.py 2>/dev/null || true

echo "I: [hifi] making OTA update scripts executable"
chmod +x /usr/local/sbin/hifi-ota-update.sh /usr/local/sbin/hifi-lyrion-update.sh \
         /usr/local/sbin/hifi-system-update.sh /usr/local/sbin/hifi-os-update.sh \
         /usr/local/sbin/hifi-update-stage-runner.sh /usr/local/sbin/hifi-update-apply-runner.sh \
         /usr/local/sbin/hifi-ota-enroll-key.sh /usr/local/sbin/hifi-ota-alpha-toggle.sh \
         2>/dev/null || true

# 🚨 hifi-bluealsa.service runs the launcher directly, so without this line
# Bluetooth output is a unit that dies with "Permission denied".
# (The system OTA path already does the same, broadly, in hifi-system-update.sh.)
echo "I: [hifi] making the Bluetooth speaker scripts executable"
chmod +x /usr/local/sbin/hifi-bluealsa-run.sh /usr/local/sbin/hifi-bt-out.py \
         /usr/local/sbin/hifi-bt-player-run.py 2>/dev/null || true

# 🚨 Il permesso di esecuzione va rimesso qui: in CI il pacchetto Qt arriva
# come artefatto e gli artefatti non lo conservano. Deve succedere prima del
# hook 0400, che abilita l'interfaccia guardando proprio se il programma e'
# eseguibile.
echo "I: [hifi] finalising the Qt on-screen UI"
chmod 755 "$QTDIR/hifi-qt"
if [ -f "$QTDIR/hifi-media-player" ]; then
    chmod 755 "$QTDIR/hifi-media-player"       # the compatibility shim for the older updaters
fi

# The interface version the updater compares against: build-distro.sh seeds
# it; a payload copied by hand gets the payload's own, else "unknown".
echo "I: [hifi] seeding UI_VERSION if missing"
mkdir -p /etc/hifi-player
if [ ! -f /etc/hifi-player/UI_VERSION ]; then
    if [ -f "$QTDIR/UI_VERSION" ]; then
        cp "$QTDIR/UI_VERSION" /etc/hifi-player/UI_VERSION
    else
        echo "unknown" > /etc/hifi-player/UI_VERSION
    fi
fi
[ -f "$QTDIR/UI_VERSION" ] || cp /etc/hifi-player/UI_VERSION "$QTDIR/UI_VERSION"

echo "I: [hifi] seeding SYSTEM_VERSION if missing"
[ -f /etc/hifi-player/SYSTEM_VERSION ] || echo "unknown" > /etc/hifi-player/SYSTEM_VERSION

echo "I: [hifi] app-install hook done"
