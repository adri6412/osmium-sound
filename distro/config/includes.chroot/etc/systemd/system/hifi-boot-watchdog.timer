[Unit]
Description=Osmium Sound — watchdog software degli avvii di prova A/B (10 min dopo l'avvio)
ConditionPathExists=/etc/rauc/system.conf
# In una sessione live non c'è niente da configurare né da sorvegliare:
# la ISO a filesystem unico avvia la stessa immagine degli apparecchi,
# quindi senza questa riga queste unità partirebbero anche lì.
ConditionKernelCommandLine=!boot=live

[Timer]
OnBootSec=10min
AccuracySec=30s

[Install]
WantedBy=timers.target
