[Unit]
Description=Osmium Sound — primo avvio di un'immagine su apparecchio convertito (unione account)
# /data e l'overlay di /etc li monta l'initramfs prima di PID 1: nessuna
# dipendenza da local-fs.target (che, via udev → tmpfiles-dev-early → sysusers,
# creerebbe un ciclo con il Before=systemd-sysusers qui sotto e systemd
# salterebbe l'unità).
DefaultDependencies=no
ConditionPathExists=/usr/lib/osmium/IMAGE_VERSION
ConditionPathExists=/data/etc/accounts-extra
ConditionPathExists=!/data/etc/upper/.hifi-accounts-merged
After=systemd-remount-fs.service
Before=sysinit.target systemd-sysusers.service shutdown.target
Conflicts=shutdown.target
# In una sessione live non c'è niente da configurare né da sorvegliare:
# la ISO a filesystem unico avvia la stessa immagine degli apparecchi,
# quindi senza questa riga queste unità partirebbero anche lì.
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hifi-ab-firstboot.sh

[Install]
WantedBy=sysinit.target
