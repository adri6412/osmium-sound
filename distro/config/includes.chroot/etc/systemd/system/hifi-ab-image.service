[Unit]
Description=Osmium Sound — carry on the A/B update chain (legacy kickoff / slot B image)
# The markers (finished/image-kicked/kickoff-done) are judged by the script:
# this unit starts on an unconverted legacy device too, to carry the chain on
# by itself after the first pass made by the old runner (2.5.23).
ConditionPathExists=!/usr/lib/osmium/IMAGE_VERSION
ConditionKernelCommandLine=!boot=live
After=hifi-ab-finish.service hifi-api.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hifi-ab-image.sh
TimeoutStartSec=3000

[Install]
WantedBy=multi-user.target
