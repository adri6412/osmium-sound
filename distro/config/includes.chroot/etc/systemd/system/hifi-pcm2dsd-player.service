[Unit]
# PCM to DSD on this device, for music that comes from another Lyrion server
# (hifi-pcm2dsd-player.py): squeezelite plays into the Loopback, this turns
# what comes out of it into DSD for the DAC. Not enabled: hifi_squeezelite.py
# starts it when it renders squeezelite's line for that path, and stops it
# when the path no longer applies (/run/hifi-pcm2dsd/player.json gone).
Description=Osmium PCM to DSD (player side)
After=sound.target
ConditionPathExists=/run/hifi-pcm2dsd/player.json

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe snd-aloop
ExecStart=/usr/bin/python3 /usr/local/sbin/hifi-pcm2dsd-player.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# It feeds the DAC: same standing as squeezelite.service (see the comments
# there on why the cgroup weights are what actually counts).
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=0
CPUAccounting=yes
CPUWeight=1000
ManagedOOMPreference=avoid
OOMScoreAdjust=-900
