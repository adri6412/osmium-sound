[Unit]
Description=Osmium Sound — re-pin driver packs to the running image and load their modules
Documentation=man:systemd-sysext(8)
# Only on image systems, and only where driver packs have been installed.
ConditionPathExists=/usr/lib/osmium/IMAGE_VERSION
ConditionPathExists=/var/lib/hifi-player/driverpack
After=systemd-sysext.service
# A live session installs nothing of its own: the single-filesystem ISO boots
# the very image the appliances run, so without this these units would start
# there too.
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
# refresh re-verifies each stored pack's signature, re-pins the firmware sysext
# to the image running now (needed after an OTA, which bumps SYSEXT_LEVEL and
# makes systemd drop the stale extension), and insmods the out-of-tree modules —
# nothing autoloads a module placed by absolute path, so this runs every boot.
ExecStart=/usr/local/sbin/hifi-driverpack.sh refresh
# A pack that cannot be re-pinned (or a module the kernel refuses under Secure
# Boot) is not a boot failure: it stays disabled and `list` says so.
SuccessExitStatus=0 1
TimeoutStartSec=300
Nice=19
IOSchedulingClass=idle

# 🚨 No [Install] section on purpose — hifi-driverpack-refresh.timer starts this,
# the same arrangement hifi-ext-refresh uses. Pulled in by WantedBy it would
# inherit an implicit Before=multi-user.target and hold the whole boot back.
# build-image.sh enables the timer.
