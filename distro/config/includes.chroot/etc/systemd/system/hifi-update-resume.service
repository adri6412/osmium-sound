[Unit]
Description=HiFi Player — resume an interrupted OTA update plan
# An OS payload that asks for a reboot ends the update run mid-plan: the
# remaining steps (typically the UI) would never be applied, which is exactly
# how appliances ended up with some components updated and others stale.
# The plan lives on persistent storage, so we simply pick it back up at boot.
# No plan file, no work — the unit is a no-op on every ordinary boot.
ConditionPathExists=/var/lib/hifi-player/update-plan
# Never in the live ISO session: there is nothing to update there.
ConditionKernelCommandLine=!boot=live
# The remaining steps download from GitHub.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/local/sbin/hifi-update-runner.sh
RemainAfterExit=no
# A full plan (download + verify + apply of up to three bundles) can legitimately
# take several minutes; don't let systemd kill it half-way.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
