#!/bin/sh
# shellcheck disable=SC2154,SC1091  # rootmnt/ROOT li imposta l'init dell'initramfs; /scripts/functions esiste solo lì
# Osmium Sound — stato persistente per la root read-only degli slot RAUC.
#
# Gira nell'initramfs dopo che la root è montata (in sola lettura) su
# ${rootmnt} e PRIMA che parta systemd, così PID 1 nasce già con:
#   /etc   = overlayfs (lower = immagine, upper/work su /data/etc)
#   /var   = bind di /data/var   (seminato dall'immagine al primo avvio)
#   /home  = bind di /data/home  (idem)
#   /boot/efi = la ESP dello stesso disco (grubenv di RAUC)
# e con /etc/machine-id già presente nell'upper: se mancasse, systemd
# tratterebbe l'avvio come "primo avvio" e riapplicherebbe i preset.
#
# È un no-op ovunque non sia uno slot immagine: senza rauc.slot= sulla riga
# di comando del kernel (o senza il marcatore dell'immagine) esce subito, e
# la root legacy scrivibile non viene toccata.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
    prereqs) prereqs; exit 0 ;;
esac
. /scripts/functions

slot=
read -r cmdline < /proc/cmdline || cmdline=
for x in $cmdline; do
    case "$x" in rauc.slot=*) slot="${x#rauc.slot=}" ;; esac
done
[ -n "$slot" ] || exit 0
[ -f "${rootmnt}/usr/lib/osmium/IMAGE_VERSION" ] || exit 0

# device della root: dal mount di ${rootmnt} (ROOT non è garantita agli hook)
rootdev=$(awk -v m="${rootmnt}" '$2 == m { d = $1 } END { print d }' /proc/mounts 2>/dev/null)
[ -n "$rootdev" ] || rootdev=$(readlink -f "${ROOT:-}" 2>/dev/null)
rootdev=$(readlink -f "$rootdev" 2>/dev/null || echo "$rootdev")
name=${rootdev#/dev/}
disk=$(basename "$(readlink -f "/sys/class/block/$name/..")")
find_part() {  # nome GPT -> /dev/…  (blkid legge la GPT: l'uevent non ha PARTNAME)
    for d in /sys/class/block/"$disk"*; do
        [ -f "$d/partition" ] || continue
        dev="/dev/$(basename "$d")"
        if [ "$(blkid -o value -s PARTLABEL "$dev" 2>/dev/null)" = "$1" ]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}
modprobe overlay 2>/dev/null || true
D="${rootmnt}/data"
datadev=
mounted=0
# 🚨 Worth waiting for, and worth retrying: falling back to tmpfs means the
# whole boot runs on the image's factory /etc — every setting the owner made
# reverted for that session (the server they follow, the network, the player
# name), and anything they change during it lost at the next boot, when the
# real partition is back and still holds the old values. That reads exactly
# like "sometimes at startup it goes back to the other server". The partition
# can simply not be there yet: the kernel finds the root first, and on slower
# controllers the rest of the table lands a moment later.
attempt=0
while [ "$attempt" -lt 15 ] && [ "$mounted" = 0 ]; do
    if [ "$attempt" -gt 0 ]; then
        udevadm settle --timeout=1 >/dev/null 2>&1 || true
        sleep 1
    fi
    attempt=$((attempt + 1))
    [ -n "$datadev" ] || datadev=$(find_part hifi-data || true)
    [ -n "$datadev" ] || continue
    fsck.ext4 -p "$datadev" >/dev/null 2>&1 || true
    mount -t ext4 -o noatime "$datadev" "$D" && mounted=1
done
if [ "$mounted" = 0 ]; then
    log_warning_msg "hifi-state: partizione hifi-data non disponibile dopo ${attempt} tentativi — stato volatile (tmpfs), le impostazioni di questo avvio NON verranno conservate"
    mount -t tmpfs -o mode=0755 tmpfs "$D"
fi
espdev=$(find_part "EFI System") || espdev=
# ── ripristino di fabbrica ────────────────────────────────────────────
# La cancellazione della partizione dati avviene QUI, non da sistema acceso:
# in /data ci sono l'upper di /etc e gli innesti di /var e /home, e un rm -rf
# a caldo taglierebbe il ramo su cui il sistema è seduto, a metà strada.
# hifi-factory-reset.sh lascia solo un marcatore e riavvia; a questo punto
# l'overlay non è ancora montato e nessuno tiene aperto niente, quindi la
# cancellazione è una cosa sola: o è avvenuta o non è avvenuta.
#
# Si salvano quattro cose. music/ perché è la musica di chi possiede
# l'apparecchio: ci finisce quella che stava in una cartella della root al
# passaggio al nuovo schema (hifi-ab-media.py) e quella copiata dopo sulle
# condivisioni di rete. Un ripristino di fabbrica rimette a posto le
# impostazioni, non cancella la discoteca: la sorgente andrà riaggiunta, i
# file no. lyrion/ perché altrimenti l'apparecchio resta senza
# server musicale finché non raggiunge internet per riscaricare il pacchetto
# (le sue preferenze e cache stanno in /var e se ne vanno comunque: Lyrion
# riparte come nuovo lo stesso). rauc/ è contabilità che non c'è motivo di
# buttare. Il machine-id perché da lui deriva il MAC di squeezelite, cioè
# l'identità del player su LMS: un ripristino serve quasi sempre a risolvere
# un problema, non a cambiare proprietario, e ricomparire come apparecchio
# sconosciuto farebbe perdere al server tutte le impostazioni di quel player.
if [ "$mounted" = 1 ] && [ -e "$D/.factory-reset" ]; then
    log_begin_msg "Osmium Sound: factory reset, erasing the data partition"
    saved_mid=$(cat "$D/etc/upper/machine-id" 2>/dev/null || true)
    for entry in "$D"/* "$D"/.[!.]* "$D"/..?*; do
        [ -e "$entry" ] || continue          # glob senza corrispondenze
        case "${entry##*/}" in
            music|lyrion|rauc) continue ;;
        esac
        rm -rf "$entry"
    done
    mkdir -p "$D/etc/upper/hifi-player"
    if [ -n "$saved_mid" ]; then
        printf '%s\n' "$saved_mid" > "$D/etc/upper/machine-id"
        chmod 0444 "$D/etc/upper/machine-id"
    fi
    # Stesso marcatore che l'installer semina su un apparecchio nuovo: senza,
    # si riparte da una /data vuota ma senza wizard di configurazione.
    printf 'pending\n' > "$D/etc/upper/hifi-player/provisioning-pending"
    sync
    log_end_msg
fi

mkdir -p "$D/etc/upper" "$D/etc/work" "$D/var" "$D/home" "$D/rauc" "$D/lyrion"

# /var e /home: al primo avvio di OGNI versione dell'immagine si copiano le
# voci dell'immagine che su /data ancora mancano (cp -an: mai sovrascrivere).
# Vale sia per la partizione appena creata sia per quella già seminata dalla
# root legacy (hifi-ab-seed.sh): lo stato esistente non viene toccato, il
# database dpkg, /var/lib/systemd ecc. dell'immagine arrivano comunque.
imgver=$(cat "${rootmnt}/usr/lib/osmium/IMAGE_VERSION" 2>/dev/null || echo unknown)
if [ "$(cat "$D/var/.hifi-image-version" 2>/dev/null)" != "$imgver" ]; then
    cp -an "${rootmnt}/var/." "$D/var/" 2>/dev/null || log_warning_msg "hifi-state: copia di /var incompleta"
    cp -an "${rootmnt}/home/." "$D/home/" 2>/dev/null || true
    printf '%s\n' "$imgver" > "$D/var/.hifi-image-version"
fi

mid="$D/etc/upper/machine-id"
if [ ! -s "$mid" ]; then
    if [ -s "${rootmnt}/etc/machine-id" ]; then
        cp "${rootmnt}/etc/machine-id" "$mid"
    else
        tr -d '-' < /proc/sys/kernel/random/uuid > "$mid"
    fi
    chmod 0444 "$mid"
fi

mount -t overlay overlay \
    -o "lowerdir=${rootmnt}/etc,upperdir=$D/etc/upper,workdir=$D/etc/work" \
    "${rootmnt}/etc" || log_warning_msg "hifi-state: overlay su /etc fallito — /etc resta in sola lettura"
mount --bind "$D/var" "${rootmnt}/var" || log_warning_msg "hifi-state: bind di /var fallito"
mount --bind "$D/home" "${rootmnt}/home" || log_warning_msg "hifi-state: bind di /home fallito"

if [ -n "$espdev" ]; then
    mkdir -p "${rootmnt}/boot/efi"
    mount -t vfat -o umask=0077 "$espdev" "${rootmnt}/boot/efi" \
        || log_warning_msg "hifi-state: ESP $espdev non montata"
fi

mkdir -p /run/hifi-state
printf '%s\n' "$rootdev" > /run/hifi-state/root
printf '%s\n' "/dev/$disk" > /run/hifi-state/disk
printf '%s\n' "$slot" > /run/hifi-state/slot
printf '%s\n' "$datadev" > /run/hifi-state/data
printf '%s\n' "$espdev" > /run/hifi-state/esp
printf '%s\n' "$mounted" > /run/hifi-state/data-mounted
exit 0
