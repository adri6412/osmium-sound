#!/bin/sh
# Osmium Sound — puts into the conversion initrd the tools needed to shrink the
# root and rewrite the GPT (see scripts/local-premount/hifi-ab-convert).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
    prereqs) prereqs; exit 0 ;;
esac
# shellcheck disable=SC1091  # only exists on the appliance
. /usr/share/initramfs-tools/hook-functions

# Under their own names (hifi-*): initramfs-tools' zz-busybox hook runs BEFORE
# this one and registers its applets (mke2fs, blkid, tune2fs...) at the very
# same paths; copy_exec does not overwrite a file that is already there, and
# BusyBox's mke2fs does not know -t (seen on the Dell). The script calls them
# by these names.
for b in sfdisk resize2fs mke2fs e2fsck tune2fs dumpe2fs blkid partx blockdev; do
    p=$(command -v "$b" 2>/dev/null) || { echo "W: hifi-ab: $b non trovato" >&2; continue; }
    p=$(readlink -f "$p")
    copy_exec "$p" "/usr/sbin/hifi-$b"
done
# mke2fs -t ext4 reads its definitions from /etc/mke2fs.conf: without it, in
# the initrd it fails ("Filesystem type ext4 not defined") — seen on the Dell,
# 2026-09-01.
if [ -f /etc/mke2fs.conf ]; then
    copy_file config /etc/mke2fs.conf
fi
manual_add_modules ext4 vfat nls_cp437 nls_ascii nls_utf8
exit 0
