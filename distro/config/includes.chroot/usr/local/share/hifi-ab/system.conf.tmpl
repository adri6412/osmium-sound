# Osmium Sound — this device's RAUC configuration.
# REGENERATED ON EVERY BOOT by /usr/local/sbin/hifi-rauc-config.sh (device
# names differ between eMMC, SATA and NVMe): do not edit by hand.
[system]
compatible=osmium-x86_64
bootloader=grub
grubenv=/boot/efi/EFI/debian/grubenv
data-directory=/data/rauc
bundle-formats=-plain

[keyring]
path=/etc/rauc/keyring.pem
use-bundle-signing-time=true

# type=raw: the image is a squashfs written to the partition exactly as it is
# (a converted legacy root, ext4, is overwritten the same way).
[slot.rootfs.0]
device=@SLOT_A@
type=raw
bootname=A

[slot.rootfs.1]
device=@SLOT_B@
type=raw
bootname=B
