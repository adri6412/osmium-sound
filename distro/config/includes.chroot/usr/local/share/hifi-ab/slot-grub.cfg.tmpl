# Osmium Sound — booting one RAUC image slot.
#
# A static GRUB script (no menu, no update-grub at runtime): the ESP's A/B
# selector loads it with `configfile` after exporting rauc_slot and the
# PARTUUID of the slot it picked. Generated at build time by
# distro/build-image.sh from usr/local/share/hifi-ab/slot-grub.cfg.tmpl
set timeout=0
set timeout_style=hidden
set gfxpayload=keep
if [ -z "$slot_partuuid" ]; then
    # Booted with no selector (testing a cloned disk): take the PARTUUID of
    # the partition this very file is being read from.
    probe --set=slot_partuuid --part-uuid $root
fi
if [ -n "$slot_partuuid" ]; then
    set rootarg="root=PARTUUID=$slot_partuuid"
else
    if [ -z "$slot_fsuuid" ]; then
        probe --set=slot_fsuuid --fs-uuid $root
    fi
    set rootarg="root=UUID=$slot_fsuuid"
fi
set slotarg=
if [ -n "$rauc_slot" ]; then
    set slotarg="rauc.slot=$rauc_slot"
fi
# Settings written from the running system (api_server.py, today the screen
# rotation for the boot splash: video=<connector>:panel_orientation=...). They
# live in a GRUB environment file of their own on the ESP (partition 2 on
# every A/B disk, hifi-ab-lib.sh), NOT in the grubenv that holds the A/B
# state. Missing or unreadable file = nothing added, the boot is as before.
set hifi_cmdline=
set hifi_disk=
regexp --set=1:hifi_disk '^\(?(hd[0-9]+),' "$root"
if [ -n "$hifi_disk" -a -e ($hifi_disk,gpt2)/EFI/debian/hifi-cmdline.env ]; then
    load_env --file=($hifi_disk,gpt2)/EFI/debian/hifi-cmdline.env hifi_cmdline
fi
linux /boot/vmlinuz-@KVER@ $rootarg ro rootfstype=squashfs $slotarg panic=10 @CMDLINE@ $hifi_cmdline
initrd /boot/initrd.img-@KVER@
boot
