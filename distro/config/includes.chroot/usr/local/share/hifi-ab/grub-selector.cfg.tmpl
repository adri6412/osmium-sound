# Osmium Sound — A/B boot selector (version 2).
#
# This text file sits on the ESP as /EFI/debian/grub.cfg, in place of the
# three-line stub grub-install writes, and is read by Debian's signed
# grubx64.efi (which stays UNTOUCHED: the bootloader binary is never modified
# here, only its configuration). It picks the slot to boot the way RAUC's own
# contrib/grub.conf does, from the ORDER / A_OK / A_TRY / B_OK / B_TRY
# variables kept in /EFI/debian/grubenv, then hands over to the chosen slot's
# grub.cfg — either the static script of a RAUC image or the Debian grub.cfg
# of a converted legacy root.
#
# 🚨 Version 2: a PROVEN image is not abandoned over one bad boot. RAUC's
# scheme makes every boot a trial (TRY=1 until hifi-boot-health.sh marks it
# good), so one boot that did not get that far — a power cut half-way, a
# slow disk check — used to send the device back to the other, older image
# for good. Now a slot whose image has already been marked good once
# (<S>_GOOD, written by hifi-boot-health.sh, equal to the OSMIUM_ID the image
# itself carries in /boot/grub/osmium-id.env) gets <S>_LEFT more attempts
# (2, restored at every good boot) before the fallback. The id is the
# image's own: a newly installed image does not carry the id that was marked
# good, so its first boot is still a one-shot trial, exactly as before — a
# broken new image still falls back after one failed boot. Images and roots
# without the file (a converted legacy root, images built before it) never
# match, and behave as in version 1.
#
# Only reaches a device when the selector is rendered: a conversion
# (hifi-ab-convert.sh select) or a fresh install (hifi-disk-install.sh). An
# image update does not rewrite it.
#
# The LAST branch is, byte for byte, today's stub: if anything above does not
# add up (grubenv missing or unreadable, partitions gone, both slots refusing
# to start) the device boots the way it always has.
#
# Rendered by hifi-ab-convert.sh / hifi-disk-install.sh: @LEGACY_UUID@ is the
# ext4 UUID of the legacy root (or of slot A on a fresh install).
# Source: distro/config/includes.chroot/usr/local/share/hifi-ab/grub-selector.cfg.tmpl
set legacy_uuid=@LEGACY_UUID@
set envfile=($root)/EFI/debian/grubenv
set ab=0
set disk=
regexp --set=1:disk '^\(?(hd[0-9]+),' "$root"
if [ -n "$disk" -a -e ($root)/EFI/debian/ab-enabled -a -e ($root)/EFI/debian/grubenv ]; then
    set ORDER="A B"
    set A_OK=1
    set A_TRY=0
    set B_OK=0
    set B_TRY=0
    set A_GOOD=
    set A_LEFT=0
    set B_GOOD=
    set B_LEFT=0
    if load_env --file=$envfile ORDER A_OK A_TRY B_OK B_TRY A_GOOD A_LEFT B_GOOD B_LEFT; then
        set ab=1
    fi
fi
if [ "$ab" = 1 ]; then
    for pass in 1 2; do
        for S in $ORDER; do
            set ok=0
            set try=1
            set part=
            set good=
            set left=0
            if [ "$S" = "A" ]; then set ok="$A_OK"; set try="$A_TRY"; set part=gpt3; set good="$A_GOOD"; set left="$A_LEFT"; fi
            if [ "$S" = "B" ]; then set ok="$B_OK"; set try="$B_TRY"; set part=gpt4; set good="$B_GOOD"; set left="$B_LEFT"; fi
            set go=0
            if [ -n "$part" -a "$ok" = 1 -a "$try" = 0 ]; then
                set go=1
                if [ "$S" = "A" ]; then set A_TRY=1; fi
                if [ "$S" = "B" ]; then set B_TRY=1; fi
                save_env --file=$envfile A_TRY B_TRY
            elif [ -n "$part" -a "$ok" = 1 -a -n "$good" ]; then
                # A boot of this slot did not reach "good". Another attempt
                # only for the very image that was proven good, and only
                # while there are attempts left.
                if [ "$left" = 1 -o "$left" = 2 -o "$left" = 3 ]; then
                    set OSMIUM_ID=
                    load_env --file=($disk,$part)/boot/grub/osmium-id.env OSMIUM_ID
                    if [ "$OSMIUM_ID" = "$good" ]; then
                        set go=1
                        if [ "$left" = 3 ]; then set left=2; elif [ "$left" = 2 ]; then set left=1; else set left=0; fi
                        if [ "$S" = "A" ]; then set A_LEFT="$left"; fi
                        if [ "$S" = "B" ]; then set B_LEFT="$left"; fi
                        save_env --file=$envfile A_LEFT B_LEFT
                    fi
                fi
            fi
            if [ "$go" = 1 ]; then
                set slot_partuuid=
                set slot_fsuuid=
                probe --set=slot_partuuid --part-uuid ($disk,$part)
                probe --set=slot_fsuuid --fs-uuid ($disk,$part)
                set rauc_slot="$S"
                export rauc_slot slot_partuuid slot_fsuuid
                if [ -e ($disk,$part)/boot/grub/grub.cfg ]; then
                    set root=($disk,$part)
                    set prefix=($root)/boot/grub
                    configfile $prefix/grub.cfg
                fi
                # Only reached when the slot failed to boot: try the next one.
            fi
        done
        # No slot left to try: give both another chance (and the other one
        # goes first next time) instead of stopping at a menu nobody can see.
        set A_TRY=0
        set B_TRY=0
        save_env --file=$envfile A_TRY B_TRY
    done
fi
# ── legacy branch: grub-install's own stub, unchanged ────────────────────
search.fs_uuid $legacy_uuid root
set prefix=($root)/boot/grub
configfile $prefix/grub.cfg
# If even this fails (legacy root overwritten and both images broken) a reboot
# beats sitting at the prompt on a device with no keyboard attached.
sleep 10
reboot
