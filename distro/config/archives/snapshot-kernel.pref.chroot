# Kernel pin (see distro/config/package-lists/hifi.list.chroot for why): take
# ONLY the pinned kernel packages from the snapshot mirror; reject everything
# else there so the snapshot cannot drag the rest of the image onto stale
# versions.
Package: linux-image-6.12.113+deb13-amd64 linux-headers-6.12.113+deb13-amd64 linux-headers-6.12.113+deb13-common linux-kbuild-6.12
Pin: origin snapshot.debian.org
Pin-Priority: 1001

Package: *
Pin: origin snapshot.debian.org
Pin-Priority: -10
