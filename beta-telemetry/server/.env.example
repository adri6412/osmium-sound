# Must match the BOOTSTRAP_SECRET constant baked into hifi-beta-agent.py --
# i.e. the HIFI_BETA_BOOTSTRAP_SECRET repository secret that build-ui-ota.yml
# and build-iso.yml substitute into the shipped copy. NOT the placeholder
# string that sits in the public source: that one is readable by anyone.
#
# Accepts a comma-separated list, so a rotation can accept both the old and
# the new value while the fleet updates (units only pick up a new secret when
# a system OTA reaches them). Remove the retired value once they have all
# checked in.
BETA_BOOTSTRAP_SECRET=

# The initial/"factory" dashboard password. Once logged in, change it any
# time from the Account page (persisted in the DB, no redeploy needed) -- or,
# if you lose it, reset it directly on the server with:
#   docker compose exec beta-server python3 reset_password.py "NewPassword"
#   docker compose exec beta-server python3 reset_password.py --clear   # revert to THIS value
#
# generate with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
#
# IMPORTANT: `docker compose` interpolates $VAR / ${VAR} inside env_file values
# (not just inside docker-compose.yml), so every literal "$" in the hash below
# MUST be doubled to "$$" or Compose silently blanks out whatever looks like a
# variable name and check_password_hash() will never match (this bit us once
# during the beta deploy: "$HWerB4IPs5U6yC7v" got read as an unset variable and
# dropped, breaking the salt). A scrypt hash always has two "$" delimiters, so
# it always needs this escaping.
# Example: scrypt:32768:8:1$abc123$def456...  ->  scrypt:32768:8:1$$abc123$$def456...
BETA_ADMIN_PASSWORD_HASH=
