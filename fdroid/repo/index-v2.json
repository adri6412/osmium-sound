{"repo": {"name": {"en-US": "Osmium Sound"}, "description": {"en-US": "Official self-hosted F-Droid repository for Osmium Sound Companion, the Android remote control app for the Osmium Sound hi-fi appliance (https://github.com/adri6412/osmium-sound).\n"}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "34609b1aaeaa0794ddd7b6e8baa1e147939737ab9e4dcf719fa3fba15b8bdba9", "size": 711}}, "address": "https://osmium-sound.pages.dev/fdroid/repo", "timestamp": 1788035483000, "categories": {"Multimedia": {"name": {"en-US": "Multimedia"}}}}, "packages": {"com.osmium.sound.companion": {"metadata": {"added": 1788035473000, "categories": ["Multimedia"], "issueTracker": "https://github.com/adri6412/osmium-sound/issues", "lastUpdated": 1788035473000, "license": "Apache-2.0", "sourceCode": "https://github.com/adri6412/osmium-sound", "webSite": "https://osmiumsound.qd.je", "featureGraphic": {"en-US": {"name": "/com.osmium.sound.companion/en-US/featureGraphic_hT3liV8m6AEmNrt0boPEatPglJtGtR4k2GP7FAtZGs0=.png", "sha256": "853de5895f26e8012636bb746e83c46ad3e0949b46b51e24d863fb140b591acd", "size": 229270}}, "screenshots": {"phone": {"en-US": [{"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/1-home-grouped.png", "sha256": "2616b47ff1fc2fbb4304a1a673f15567681bd09de9e4144d5cd894687e619977", "size": 178669}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/1-home.png", "sha256": "d6dcc0b6606eb0353425cfb5a2045bb47a8026cbed501494076a41d031706649", "size": 163262}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/2-now-playing.png", "sha256": "00b99cb0272ef33bed4b0b2013bc730a97e162f9b6ae0f227e9e4807b922acf6", "size": 1131047}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/3-browse-albums-and-context-menu.png", "sha256": "f3bb8996779f55743f92699ad7f62ab431b5ad132f099f1e54304732f269db56", "size": 188203}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/4-artist-info.png", "sha256": "ab81d8a26ca013fadce879b4642d30b9cdbf083561922391c4c06cd6e4591772", "size": 583634}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/5-player-control.png", "sha256": "3aeb57b36c4e0e28ef18464bb2e21e13f531b87e2196774a1cf220d6a9a0a94c", "size": 166857}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/6-notification.png", "sha256": "0786df0b59006707b21510dcbe6c5162b05a5bbe9ce70379e14fbccde7925c4f", "size": 367692}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/8-now-playing-small-album-art.png", "sha256": "49daf0315bd266a47507d923c13c64f5da80dd51161fe1148532b101f3d93192", "size": 135462}]}}, "name": {"en-US": "Osmium Sound Companion"}, "summary": {"en-US": "Official remote control companion for your Osmium Sound appliance."}, "description": {"en-US": "Osmium Sound Companion is the official remote control app for your Osmium Sound hi-fi appliance, and a Lyrion player in its own right. Pair instantly by scanning the QR code shown in Osmium Sound → Settings → Phone control, then control playback from anywhere on your local network.\n\nFeatures include:\n\n* Play on the phone itself: it registers with Lyrion as a player of its own, with gapless playback and a quality setting per network\n* Works either with an Osmium Sound appliance (QR pairing, appliance settings) or with any other Lyrion server (host and port)\n* Browse the library by album artist, all artists, composers, album, genre, year, playlist, favorites, or new music\n* Playlist control (now playing, shuffle, repeat, save/clear/modify playlists)\n* Manage players (names, synchronisation groups, sleep, alarms)\n* Full library search\n* Internet radio support (browse, staff picks, search)\n* Browse music folders\n* Library Views and Remote Music Libraries\n* Automatic discovery of Osmium Sound appliances on the local network\n* QR code pairing\n* DSP settings and system administration controls\n* Home Screen Widgets\n* Alarm Clock management\n* Add/remove music from favorites\n* Display lyrics\n\nOsmium Sound Companion is free and open source (Apache License 2.0), built on the android-squeezer project. It only talks to your own Osmium Sound appliance over your local network — no cloud service, no tracking, no ads.\n"}, "icon": {"en-US": {"name": "/com.osmium.sound.companion/en-US/icon_1TvqyKm8CKgm9jirIYUvJOwyUo1vbClqBuTT-BcUTS8=.png", "sha256": "d53beac8a9bc08a826f638ab21852f24ec32528d6f6c296a06e4d3f817144d2f", "size": 179731}}, "preferredSigner": "f0f057f81bd238e201a2f863ba0a1e5328795298ec836ba26ab99407c5c5ec6c"}, "versions": {"a3128b85d4c212de110d5c24ccbec1021211c975b427ec094f80faf762c30af0": {"added": 1788035473000, "file": {"name": "/HiFiMediaPlayer-companion-v1.0.8-release.apk", "sha256": "a3128b85d4c212de110d5c24ccbec1021211c975b427ec094f80faf762c30af0", "size": 16718460}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.8", "versionCode": 29, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["f0f057f81bd238e201a2f863ba0a1e5328795298ec836ba26ab99407c5c5ec6c"]}, "usesPermission": [{"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.CHANGE_WIFI_STATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 28}, {"name": "android.permission.REORDER_TASKS"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.CAMERA"}, {"name": "com.osmium.sound.companion.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 28}]}}, "2cefbb4465fc1960b2fb265de4fc85a0b3f42b220961f1829353768254a3677c": {"ad