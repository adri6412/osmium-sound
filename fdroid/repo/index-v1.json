{"repo": {"timestamp": 1789405682000, "version": 20002, "name": "Osmium Sound", "icon": "icon.png", "address": "https://osmium-sound.pages.dev/fdroid/repo", "description": "Official self-hosted F-Droid repository for Osmium Sound Companion, the Android remote control app for the Osmium Sound hi-fi appliance (https://github.com/adri6412/osmium-sound).\n"}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["Multimedia"], "suggestedVersionCode": "32", "issueTracker": "https://github.com/adri6412/osmium-sound/issues", "license": "Apache-2.0", "sourceCode": "https://github.com/adri6412/osmium-sound", "webSite": "https://osmiumsound.qd.je", "added": 1789405670000, "packageName": "com.osmium.sound.companion", "lastUpdated": 1789405672000, "localized": {"en-US": {"description": "Osmium Sound Companion is the official remote control app for your Osmium Sound hi-fi appliance, and a Lyrion player in its own right. Pair instantly by scanning the QR code shown in Osmium Sound \u2192 Settings \u2192 Phone control, then control playback from anywhere on your local network.\n\nFeatures include:\n\n* Play on the phone itself: it registers with Lyrion as a player of its own, with gapless playback and a quality setting per network\n* Works either with an Osmium Sound appliance (QR pairing, appliance settings) or with any other Lyrion server (host and port)\n* Browse the library by album artist, all artists, composers, album, genre, year, playlist, favorites, or new music\n* Playlist control (now playing, shuffle, repeat, save/clear/modify playlists)\n* Manage players (names, synchronisation groups, sleep, alarms)\n* Full library search\n* Internet radio support (browse, staff picks, search)\n* Browse music folders\n* Library Views and Remote Music Libraries\n* Automatic discovery of Osmium Sound appliances on the local network\n* QR code pairing\n* DSP settings and system administration controls\n* Home Screen Widgets\n* Alarm Clock management\n* Add/remove music from favorites\n* Display lyrics\n\nOsmium Sound Companion is free and open source (Apache License 2.0), built on the android-squeezer project. It only talks to your own Osmium Sound appliance over your local network \u2014 no cloud service, no tracking, no ads.\n", "featureGraphic": "featureGraphic_hT3liV8m6AEmNrt0boPEatPglJtGtR4k2GP7FAtZGs0=.png", "icon": "icon_1TvqyKm8CKgm9jirIYUvJOwyUo1vbClqBuTT-BcUTS8=.png", "name": "Osmium Sound Companion", "phoneScreenshots": ["1-home-grouped.png", "1-home.png", "2-now-playing.png", "3-browse-albums-and-context-menu.png", "4-artist-info.png", "5-player-control.png", "6-notification.png", "8-now-playing-small-album-art.png"], "summary": "Official remote control companion for your Osmium Sound appliance."}}}], "packages": {"com.osmium.sound.companion": [{"added": 1789405670000, "apkName": "HiFiMediaPlayer-companion-v1.0.11-release.apk", "hash": "8e579377be8eb08f52d3c2ddecffd6d866c554e3a79f63c7c56a8e0bf5e86601", "hashType": "sha256", "minSdkVersion": 26, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "com.osmium.sound.companion", "sig": "030212a8287c90e43cf4fe4a119e235a", "signer": "f0f057f81bd238e201a2f863ba0a1e5328795298ec836ba26ab99407c5c5ec6c", "size": 16944918, "targetSdkVersion": 36, "uses-permission": [["android.permission.ACCESS_WIFI_STATE", null], ["android.permission.CHANGE_WIFI_STATE", null], ["android.permission.INTERNET", null], ["android.permission.SCHEDULE_EXACT_ALARM", null], ["android.permission.WAKE_LOCK", null], ["android.permission.VIBRATE", null], ["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.WRITE_EXTERNAL_STORAGE", 28], ["android.permission.REORDER_TASKS", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK", null], ["android.permission.READ_PHONE_STATE", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.CAMERA", null], ["com.osmium.sound.companion.DYNAMIC_RECEIVER_NO