{"repo": {"name": {"en-US": "Osmium Sound (Dev)"}, "description": {"en-US": "Development builds of Osmium Sound Companion (tags with a \"-svil\" suffix), published from the same source as https://osmiumsound.qd.je/fdroid/repo but ahead of it and NOT tested to the same standard. Add this repo only if you want early/unstable builds; leave it out to stay on stable releases only. (https://github.com/adri6412/osmium-sound).\n"}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "c066c9a5a555cad1a787d58491512a2d3ef0baa1dcaf940830de917ed5658bca", "size": 701}}, "address": "https://osmiumsound.qd.je/fdroid/dev/repo", "timestamp": 1786476816000, "categories": {"Multimedia": {"name": {"en-US": "Multimedia"}}}}, "packages": {"com.osmium.sound.companion": {"metadata": {"added": 1786476804000, "categories": ["Multimedia"], "issueTracker": "https://github.com/adri6412/osmium-sound/issues", "lastUpdated": 1786476807000, "license": "Apache-2.0", "sourceCode": "https://github.com/adri6412/osmium-sound", "webSite": "https://osmiumsound.qd.je", "featureGraphic": {"en-US": {"name": "/com.osmium.sound.companion/en-US/featureGraphic_hT3liV8m6AEmNrt0boPEatPglJtGtR4k2GP7FAtZGs0=.png", "sha256": "853de5895f26e8012636bb746e83c46ad3e0949b46b51e24d863fb140b591acd", "size": 229270}}, "screenshots": {"phone": {"en-US": [{"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/1-home-grouped.png", "sha256": "2616b47ff1fc2fbb4304a1a673f15567681bd09de9e4144d5cd894687e619977", "size": 178669}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/1-home.png", "sha256": "d6dcc0b6606eb0353425cfb5a2045bb47a8026cbed501494076a41d031706649", "size": 163262}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/2-now-playing.png", "sha256": "00b99cb0272ef33bed4b0b2013bc730a97e162f9b6ae0f227e9e4807b922acf6", "size": 1131047}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/3-browse-albums-and-context-menu.png", "sha256": "f3bb8996779f55743f92699ad7f62ab431b5ad132f099f1e54304732f269db56", "size": 188203}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/4-artist-info.png", "sha256": "ab81d8a26ca013fadce879b4642d30b9cdbf083561922391c4c06cd6e4591772", "size": 583634}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/5-player-control.png", "sha256": "3aeb57b36c4e0e28ef18464bb2e21e13f531b87e2196774a1cf220d6a9a0a94c", "size": 166857}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/6-notification.png", "sha256": "0786df0b59006707b21510dcbe6c5162b05a5bbe9ce70379e14fbccde7925c4f", "size": 367692}, {"name": "/com.osmium.sound.companion/en-US/phoneScreenshots/8-now-playing-small-album-art.png", "sha256": "49daf0315bd266a47507d923c13c64f5da80dd51161fe1148532b101f3d93192", "size": 135462}]}}, "name": {"en-US": "Osmium Sound Companion"}, "summary": {"en-US": "Official remote control companion for your Osmium Sound appliance."}, "description": {"en-US": "Osmium Sound Companion is the official remote control app for your Osmium Sound hi-fi appliance. Pair instantly by scanning the QR code shown in Osmium Sound → Settings → Phone control, then control playback from anywhere on your local network.\n\nFeatures include:\n\n* Browse the library by album artist, all artists, composers, album, genre, year, playlist, favorites, or new music\n* Playlist control (now playing, shuffle, repeat, save/clear/modify playlists)\n* Manage players (names, synchronisation groups, sleep, alarms)\n* Full library search\n* Internet radio support (browse, staff picks, search)\n* Browse music folders\n* Library Views and Remote Music Libraries\n* Automatic discovery of Osmium Sound appliances on the local network\n* QR code pairing\n* DSP settings and system administration controls\n* Home Screen Widgets\n* Alarm Clock management\n* Add/remove music from favorites\n* Display lyrics\n\nOsmium Sound Companion is free and open source (Apache License 2.0), built on the android-squeezer project. It only talks to your own Osmium Sound appliance over your local network — no cloud service, no tracking, no ads.\n"}, "icon": {"en-US": {"name": "/com.osmium.sound.companion/en-US/icon_1TvqyKm8CKgm9jirIYUvJOwyUo1vbClqBuTT-BcUTS8=.png", "sha256": "d53beac8a9bc08a826f638ab21852f24ec32528d6f6c296a06e4d3f817144d2f", "size": 179731}}, "preferredSigner": "f0f057f81bd238e201a2f863ba0a1e5328795298ec836ba26ab99407c5c5ec6c"}, "versions": {"9bc8fcdf920b69d658fe03fc66a304d60a1f739d090f5f5a5a6f59baf71305f6": {"added": 1786476807000, "file": {"name": "/HiFiMediaPlayer-companion-v1.0.7-svil8-release.apk", "sha256": "9bc8fcdf920b69d658fe03fc66a304d60a1f739d090f5f5a5a6f59baf71305f6", "size": 8179733}, "manifest": {"versionName": "1.0.7-svil8", "versionCode": 22, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["f0f057f81bd238e201a2f863ba0a1e5328795298ec836ba26ab99407c5c5ec6c"]}, "usesPermission": [{"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.CHANGE_WIFI_STATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 28}, {"name": "android.permission.REORDER_TASKS"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.CAMERA"}, {"name": "com.osmium.sound.companion.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 28}]}}, "af645a0faac12525f444bdc5361ed63eaa055cae73ff53a5fc404d299f677f22": {"added": 1786476806000, "file": {"name": "/HiFiMediaPlayer-companion-v1.0.7-svil7-release.apk", "sha256": "af645a0faac12525f444bdc5361ed63eaa055cae73ff53a5fc404d299f677f22", "size": 