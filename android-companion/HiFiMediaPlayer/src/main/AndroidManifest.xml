<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.REORDER_TASKS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE" android:minSdkVersion="31"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- QR scan (pairing): requested at runtime before the first scan -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:name=".HiFiMediaPlayer"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true">

        <!-- Per-app language (Settings → Display → Language). On Android 13+
             the platform stores the choice; on older releases appcompat needs
             this service to persist it across restarts. `enabled=false` is
             required: it is a metadata holder, never actually started. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Newer Android versions no longer include the Apache HTTP library -->
        <uses-library android:name="org.apache.http.legacy" android:required="false" />

        <activity android:exported="true"
            android:name=".kiosk.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".itemlist.HomeMenuActivity"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity android:exported="false"
            android:name=".NowPlayingActivity"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/activity_settings_name"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity
            android:name=".DspSettingsActivity"
            android:label="@string/settings_dsp_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".BackupRestoreActivity"
            android:label="@string/settings_backup_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".AudioOutputActivity"
            android:label="@string/settings_audio_output_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".UpdatesActivity"
            android:label="@string/settings_updates_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".SystemAdminActivity"
            android:label="@string/settings_system_admin_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".SourcesActivity"
            android:label="@string/sources_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".ServicesActivity"
            android:label="@string/appliance_section_services"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".AppliancePlaybackActivity"
            android:label="@string/appliance_section_playback"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".DisplayActivity"
            android:label="@string/appliance_section_display"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".MultiroomActivity"
            android:label="@string/settings_multiroom_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".VuMetersActivity"
            android:label="@string/settings_tile_vu_meters"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".ResolutionActivity"
            android:label="@string/settings_tile_ui_resolution"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".RefreshRateActivity"
            android:label="@string/settings_ui_refresh_title"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".PointerActivity"
            android:label="@string/settings_tile_pointer"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".SystemInfoActivity"
            android:label="@string/settings_tile_system_info"
            android:parentActivityName=".SettingsActivity">
        </activity>

        <activity
            android:name=".ConnectActivity"
            android:label="@string/disconnected_text"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity android:exported="false"
            android:name=".itemlist.PlayerListActivity"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity android:exported="false"
            android:name=".itemlist.AlarmsActivity"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity
            android:name=".itemlist.AlarmPlaylistActivity"
            android:parentActivityName=".itemlist.AlarmsActivity">
        </activity>

        <activity android:exported="false"
            android:name=".itemlist.CurrentPlaylistActivity"
            android:parentActivityName=".NowPlayingActivity">
        </activity>

        <activity
            android:name=".itemlist.JiveItemListActivity"
            android:parentActivityName=".kiosk.MainActivity">
        </activity>

        <activity
            android:name=".itemlist.GalleryActivity"
            android:parentActivityName=".itemlist.JiveItemListActivity">
        </activity>

        <activity
            android:name=".screensaver.Screensaver"
            android:theme="@style/Theme.MaterialComponents.NoActionBar">
        </activity>

        <service android:exported="false" android:label="Osmium Sound Service"
            android:foregroundServiceType="mediaPlayback"
            android:name=".service.SqueezeService">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <receiver android:exported="false"
            android:name="androidx.media.session.MediaButtonReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".download.CancelDownloadsActivity"
            android:theme="@style/Theme.Material3.Dark.Dialog"/>

        <receiver android:exported="true"
            android:name=".download.DownloadStatusReceiver">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
                <action android:name="android.intent.action.DOWNLOAD_NOTIFICATION_CLICKED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
