<?xml version="1.0" encoding="utf-8"?>
<!-- Shared folders: what this player publishes on the network, with the
     addresses and login to reach them from a computer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sources_share_hint"
        android:textColor="@color/hifiSilver"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/sources_share_need_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sources_need_os_update"
        android:textColor="@color/osmium_error"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sources_share_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sources_share_none"
        android:textColor="@color/hifiSilver"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sources_share_block"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sources_share_list"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sources_share_alt_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/hifiSilver"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sources_share_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@android:color/white"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sources_smb_regenerate_hint"
            android:textColor="@color/hifiSilver" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sources_share_regenerate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sources_smb_regenerate" />
    </LinearLayout>

    <!-- "Share a local folder" menu line is added here by SourcesActivity. -->
    <LinearLayout
        android:id="@+id/sources_share_local_row"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>
