<?xml version="1.0" encoding="utf-8"?>
<!-- An internal disk: model, size and state, with "use" / "format" when not
     already in use. A disk with several partitions lists them underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/sources_disk_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/sources_disk_badges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hifiGold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sources_disk_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hifiSilver" />

    <LinearLayout
        android:id="@+id/sources_disk_actions"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sources_disk_adopt"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/sources_internal_adopt"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sources_disk_format"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sources_internal_format"
            android:textColor="@color/osmium_error" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sources_disk_partitions"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:visibility="gone" />
</LinearLayout>
