<?xml version="1.0" encoding="utf-8"?>
<!-- One tile of the Settings grid (SettingsTilesFragment): the same card as the
     kiosk's Settings tiles, gold outline on the dark surface. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/osmium_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/osmium_gold"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/settings_tile_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/osmium_gold_container"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/osmium_gold"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/settings_tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/settings_tile_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/osmium_silver" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
