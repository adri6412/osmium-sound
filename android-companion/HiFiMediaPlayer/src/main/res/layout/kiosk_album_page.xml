<!-- Bespoke album page, mirroring native-ui-qt AlbumPage.qml: cover + details, the
     play/shuffle/queue buttons and the track list. Phone-portrait layout; the
     w600dp variant puts the cover beside the details. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/osmium_black">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/album_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Header: cover + details -->
            <ImageView
                android:id="@+id/album_cover"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:background="@color/osmium_surface"
                android:contentDescription="@string/app_name"
                tools:src="@drawable/pending" />

            <TextView
                android:id="@+id/album_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="¡UNO!" />

            <TextView
                android:id="@+id/album_artists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/osmium_gold"
                android:textSize="16sp"
                tools:text="Green Day" />

            <TextView
                android:id="@+id/album_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_horizontal"
                android:textColor="@color/osmium_silver"
                android:textSize="14sp"
                tools:text="2012 · 12 tracks · 41:58" />

            <TextView
                android:id="@+id/album_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/kiosk_format_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/osmium_gold"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="FLAC · 96 kHz"
                tools:visibility="visible" />

            <!-- Action row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/kiosk_album_play"
                    android:textColor="@color/osmium_black"
                    app:icon="@drawable/ic_action_play"
                    app:iconTint="@color/osmium_black"
                    app:backgroundTint="@color/osmium_gold"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_shuffle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/kiosk_album_shuffle"
                    app:icon="@drawable/ic_shuffle_album"
                    app:iconTint="@color/osmium_silver"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="@color/osmium_border"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/kiosk_album_add"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/osmium_silver"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="@color/osmium_border"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_next"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/kiosk_album_play_next"
                    app:icon="@drawable/ic_action_playlist"
                    app:iconTint="@color/osmium_silver"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="@color/osmium_border"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/osmium_border" />

            <ProgressBar
                android:id="@+id/album_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/osmium_gold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/album_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/kiosk_album_track_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
