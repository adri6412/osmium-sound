<?xml version="1.0" encoding="utf-8"?>
<!-- Format wizard for one internal disk: choose → confirm → progress → done/error.
     Each step is its own block; sources/FormatDiskDialog.java shows one at a time. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- choose -->
        <LinearLayout
            android:id="@+id/sources_format_step_choose"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sources_wizard_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/sources_format_disk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hifiSilver" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sources_fs_label"
                android:textColor="@android:color/white" />

            <RadioGroup
                android:id="@+id/sources_format_fs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/sources_format_fs_ext4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sources_fs_ext4"
                    android:checked="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="32dp"
                    android:paddingEnd="0dp"
                    android:text="@string/sources_fs_ext4_hint"
                    android:textColor="@color/hifiSilver"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/sources_format_fs_exfat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sources_fs_exfat" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="32dp"
                    android:paddingEnd="0dp"
                    android:text="@string/sources_fs_exfat_hint"
                    android:textColor="@color/hifiSilver"
                    android:textSize="12sp" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/sources_label_field">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sources_format_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="16" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sources_format_cancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/sources_common_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sources_format_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sources_common_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- confirm: type the label to arm the button -->
        <LinearLayout
            android:id="@+id/sources_format_step_confirm"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sources_warn_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/osmium_error" />

            <TextView
                android:id="@+id/sources_format_warn_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/hifiSilver" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sources_format_typed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sources_format_typed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sources_format_back"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/sources_common_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sources_format_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/osmium_error"
                    android:text="@string/sources_format_now" />
            </LinearLayout>
        </LinearLayout>

        <!-- progress -->
        <LinearLayout
            android:id="@+id/sources_format_step_progress"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/sources_format_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/sources_format_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/sources_format_pct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/hifiSilver" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/sources_keep_powered"
                android:textColor="@color/hifiSilver" />
        </LinearLayout>

        <!-- done / error share one block: title, text, close -->
        <LinearLayout
            android:id="@+id/sources_format_step_result"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/sources_format_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/sources_format_result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/hifiSilver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sources_format_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sources_common_close" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
