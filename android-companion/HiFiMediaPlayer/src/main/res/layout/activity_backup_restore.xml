<?xml version="1.0" encoding="utf-8"?>
<!-- Body of BackupRestoreActivity (inflated into appliance_settings_screen):
     the web admin's Settings → Backup & restore card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView style="@style/ApplianceHelp" android:text="@string/appliance_backup_hint" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/appliance_backup_passphrase">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/backup_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:autofillHints="password" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/ApplianceHelp"
        android:layout_marginTop="4dp"
        android:text="@string/appliance_backup_passphrase_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_backup_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appliance_backup_create" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_export_backup"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appliance_backup_download_now" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_restore_backup"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appliance_backup_restore_from_file" />

    <LinearLayout
        android:id="@+id/backup_scheduled_block"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <View style="@style/ApplianceDivider" />
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/appliance_backup_scheduled" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_backup_scheduled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView style="@style/ApplianceHelp" android:text="@string/appliance_backup_scheduled_hint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/backup_list_block"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <View style="@style/ApplianceDivider" />
        <TextView style="@style/ApplianceTitle" android:text="@string/appliance_backup_stored" />
        <TextView
            android:id="@+id/backup_none"
            style="@style/ApplianceHelp"
            android:text="@string/appliance_backup_none"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/backup_list"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
