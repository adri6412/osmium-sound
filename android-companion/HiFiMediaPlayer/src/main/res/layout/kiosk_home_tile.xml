<?xml version="1.0" encoding="utf-8"?>
<!-- One home tile, kiosk style: a square-ish surface card with a gold icon
     over a label. The grid (HomeTilesFragment) sets the width; height is fixed
     like the kiosk's 117-point tiles. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/osmium_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/osmium_border"
    app:strokeWidth="1dp"
    app:rippleColor="@color/osmium_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            app:tint="@color/osmium_gold"
            tools:src="@drawable/ml_albums" />

        <TextView
            android:id="@+id/tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            tools:text="Albums" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
