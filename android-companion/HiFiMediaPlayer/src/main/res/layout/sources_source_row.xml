<?xml version="1.0" encoding="utf-8"?>
<!-- One active source: name + kind, where it lives, free space, and its actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/sources_source_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/sources_source_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hifiGold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sources_source_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hifiSilver"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/sources_source_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hifiSilver"
        android:alpha="0.75"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sources_source_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sources_pending_choice"
        android:textColor="@color/osmium_error"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sources_source_rw"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sources_source_subpath"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sources_subpath_pick"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sources_source_remove"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/sources_remove"
        android:textColor="@color/osmium_error" />

    <!-- Inline subfolder browser, filled in while this source is being narrowed. -->
    <LinearLayout
        android:id="@+id/sources_source_browse"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
