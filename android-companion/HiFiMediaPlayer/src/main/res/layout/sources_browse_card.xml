<?xml version="1.0" encoding="utf-8"?>
<!-- Subfolder browser under a source's own mount (smb/internal/usb only). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/hifiDarkGray">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sources_browse_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hifiSilver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sources_browse_close"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sources_common_back" />
        </LinearLayout>

        <TextView
            android:id="@+id/sources_browse_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sources_common_loading"
            android:textColor="@color/hifiSilver"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sources_browse_body"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sources_browse_up"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sources_subpath_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sources_browse_use_here"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sources_subpath_use_here" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sources_browse_use_root"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sources_subpath_use_root" />

            <TextView
                android:id="@+id/sources_browse_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sources_subpath_no_subfolders"
                android:textColor="@color/hifiSilver"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sources_browse_dirs"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
