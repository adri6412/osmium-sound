<?xml version="1.0" encoding="utf-8"?>
<!-- Body of SystemInfoActivity: the read-only system info split out of the web
     admin's Settings → System card into a screen of its own, to match the
     kiosk's System Information section. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView style="@style/ApplianceTitle" android:text="@string/settings_system_info_title" />

    <TextView
        android:id="@+id/system_info_text"
        style="@style/ApplianceHelp"
        android:textIsSelectable="true" />

</LinearLayout>
