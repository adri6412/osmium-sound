<?xml version="1.0" encoding="utf-8"?>
<!-- A USB device needing attention: no usable filesystem, or its mount failed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/sources_usb_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/sources_usb_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hifiGold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sources_usb_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/osmium_error" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sources_usb_retry"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/sources_usb_retry"
        android:visibility="gone" />
</LinearLayout>
