<!--
General layout for grid items.

The layout contains:

 * @id/icon - ImageView, suitable for showing album artwork or other
   icons.

 * @id/text1 - TextView, main entry text.

 * @id/text2 - TextView, detail entry text.

 * @id/context_menu - ListImageButton, displaying an indicator for a drop
   down menu.

The individual visibility of the views is controlled by code, see
BaseItemView#getAdapterView(View, ViewGroup, EnumSet<ViewParams>)
for the implementation.

-->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SqueezerWidget.Grid.Item">

    <ImageView
        android:id="@+id/icon"
        style="@style/SqueezerWidget.Grid.CoverArt"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/app_name"
        tools:src="@drawable/pending"/>

    <TextView
        android:id="@+id/text1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/context_menu"
        android:paddingTop="4dp"
        android:textAppearance="@style/SqueezerTextAppearance.GridItem.Primary"
        tools:text="Album name"/>

    <TextView
        android:id="@+id/text2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/context_menu"
        android:textAppearance="@style/SqueezerTextAppearance.GridItem.Secondary"
        tools:text="Artist info"/>

    <include
        layout="@layout/context_menu_image_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/icon"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gold play disc overlaid on the album tile, mirroring native-ui-qt LibraryList.
         Shown (one-tap play) only when the row carries a play action. -->
    <ImageView
        android:id="@+id/play_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="@drawable/kiosk_play_circle"
        android:src="@drawable/ic_action_play"
        android:scaleType="fitCenter"
        android:elevation="4dp"
        android:visibility="gone"
        android:contentDescription="@string/kiosk_play_this"
        app:tint="@color/osmium_black"
        app:layout_constraintBottom_toBottomOf="@id/icon"
        app:layout_constraintEnd_toEndOf="@id/icon"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
