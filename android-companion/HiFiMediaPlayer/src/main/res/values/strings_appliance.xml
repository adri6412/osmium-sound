    <!-- iPhone / iPad -->
    <string name="appliance_lyrplay_hint">On iPhone and iPad, use LyrPlay: a free App Store app for Lyrion, with FLAC playback, background playback, lock-screen controls, CarPlay and Siri. Scan the QR code with the iPhone to download it. Updates, restart and the music server choice stay in this app, on the device\'s screen and in the web admin.</string>
