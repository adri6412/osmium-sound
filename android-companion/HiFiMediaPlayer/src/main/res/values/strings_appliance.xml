    <string name="appliance_display_engine_failed">Interface change failed</string>
    <string name="appliance_display_resolution_label">Interface resolution</string>
    <string name="appliance_display_resolution_help">On large screens the interface is drawn at full panel resolution, which keeps the graphics chip busy. Rendering it lower and letting the screen enlarge it makes everything much smoother, at the cost of some sharpness.</string>
