    <string name="appliance_display_confirm_resolution">The device\'s interface will close and reopen after a few seconds. Playback is not interrupted. Continue?</string>
    <string name="appliance_display_pointer_label">Mouse pointer</string>
    <string name="appliance_display_pointer_help">Show the mouse pointer on screen, or hide it if you only use the touchscreen. Shown by default, so the on-screen setup wizard stays usable.</string>
