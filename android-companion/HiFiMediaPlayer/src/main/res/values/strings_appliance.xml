    <string name="appliance_display_player_label">Player</string>
    <string name="appliance_display_player_help">Turn the player itself off for a server-only unit: Lyrion Music Server and everything else keeps running, this device just never plays audio itself. Useful for a box in a closet serving other players elsewhere.</string>
