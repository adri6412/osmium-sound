<!--
  The Settings screen is a grid of tiles (see SettingsCatalog): the macro
  groups and their sections are chosen there, in Java, using the same
  grouping and naming as the kiosk's Settings (native-ui-qt SettingsTab.qml).

  Each PreferenceScreen below is one leaf of that grid: a section whose
  content is a short list of preferences. It is opened by key, so every key
  must stay unique. Sections that are a whole screen of their own (audio
  output, sources, display...) are activities and are not listed here.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="first_preferencescreen">

    <!-- Music & library ................................................ -->
    <!-- Library rescan and the Lyrion web-player skin moved into the
         Lyrion Music Server screen (MultiroomActivity), to match the kiosk's
         own grouping. -->

    <PreferenceScreen
        android:key="squeezer.leaf.playback"
        android:title="@string/appliance_section_playback">

        <!-- Hidden at run time on a plain Lyrion server. -->
        <Preference
            android:key="squeezer.appliance_playback.open"
            android:icon="@drawable/ic_action_play"
            android:title="@string/appliance_section_playback"
            android:summary="@string/appliance_section_playback_desc"/>

        <Preference
            android:key="squeezer.playback.open"
            android:icon="@drawable/ic_action_play"
            android:title="@string/settings_playback_open_title"
            android:summary="@string/settings_playback_open_summary"/>

        <com.osmium.sound.companion.IntEditTextPreference
            android:key="squeezer.fadeInSecs"
            android:title="@string/settings_fadeinsecs_title"
            android:dialogMessage="@string/settings_fadeinsecs_summary"/>

        <ListPreference
            android:key="squeezer.action_on_incoming_call"
            android:title="@string/settings_action_on_incoming_call_title"
            android:summary="%s"/>

        <CheckBoxPreference
            android:key="squeezer.restore_after_call"
            android:summary="@string/settings_restore_after_call"/>
    </PreferenceScreen>

    <PreferenceScreen
        android:key="squeezer.leaf.download"
        android:title="@string/settings_category_download">

        <SwitchPreferenceCompat
            android:key="squeezer.download.enabled"
            android:title="@string/settings_download_enabled"/>

        <CheckBoxPreference
            android:key="squeezer.download.confirmation"
            android:title="@string/settings_download_confirmation"/>

        <CheckBoxPreference
            android:key="squeezer.download.use_server_path"
            android:title="@string/settings_download_use_server_path"/>

        <ListPreference
            android:key="squeezer.download.path_structure"
            android:title="@string/settings_download_path_structure"
            android:summary="%s"/>

        <ListPreference
            android:key="squeezer.download.filename_structure"
            android:title="@string/settings_download_filename_structure"
            android:summary="%s"/>
    </PreferenceScreen>

    <!-- Look & screen ................................................. -->

    <PreferenceScreen
        android:key="squeezer.leaf.display"
        android:title="@string/settings_tile_language_screen">

        <ListPreference
            android:key="squeezer.theme"
            android:title="@string/settings_theme_title"
            android:summary="%s"/>

        <ListPreference
            android:key="squeezer.language"
            android:title="@string/settings_language_title"
            android:summary="%s"/>

        <ListPreference
            android:key="squeezer.screensaver"
            android:title="@string/settings_screensaver_title"
            android:summary="%s"/>
        <ListPreference
            android:key="squeezer.fullscreen"
            android:title="@string/fullscreen_mode"
            android:summary="%s"/>
    </PreferenceScreen>

    <PreferenceScreen
        android:key="squeezer.leaf.nowplaying"
        android:title="@string/settings_category_nowplaying_trackinfo">

        <SwitchPreferenceCompat
            android:key="squeezer.now_playing_volume"
            android:summaryOff="@string/don_t_show_volume_control"
            android:summaryOn="@string/show_volume_control"
            android:title="@string/volume"/>

        <SwitchPreferenceCompat
            android:key="squeezer.show_track_count"
            android:summaryOff="@string/settings_show_track_number_off"
            android:summaryOn="@string/settings_show_track_number_on"
            android:title="@string/settings_show_track_number_title"/>

        <SwitchPreferenceCompat
            android:key="squeezer.show_technical_info"
            android:summaryOff="@string/settings_show_technical_info_off"
            android:summaryOn="@string/settings_show_technical_info_on"
            android:title="@string/settings_show_technical_info_title"/>

        <SwitchPreferenceCompat
            android:key="squeezer.add_composer_line"
            android:summaryOff="@string/settings_add_composer_line_off"
            android:summaryOn="@string/settings_add_composer_line_on"
            android:title="@string/settings_add_composer_line_title"/>

        <SwitchPreferenceCompat
            android:key="squeezer.add_conductor_line"
            android:summaryOff="@string/settings_add_conductor_line_off"
            android:summaryOn="@string/settings_add_conductor_line_on"
            android:title="@string/settings_add_conductor_line_title"/>

        <SwitchPreferenceCompat
            android:key="squeezer.display_classical_music_tags"
            android:summaryOff="@string/settings_classical_music_tags_off"
            android:summaryOn="@string/settings_classical_music_tags_on"
            android:title="@string/settings_classical_music_tags_title"/>
    </PreferenceScreen>

    <PreferenceScreen
        android:key="squeezer.leaf.interface"
        android:title="@string/settings_tile_interface">

        <ListPreference
            android:key="squeezer.top_bar.search"
            android:title="@string/settings_top_bar_search"
            android:summary="%s"/>

        <SwitchPreferenceCompat
            android:key="squeezer.launcher.enabled"
            android:title="@string/settings_launcher_title"
            android:summary="@string/settings_launcher_summary"/>

        <SwitchPreferenceCompat
            android:key="squeezer.clear.current_playlist.confirmation"
            android:summaryOff="@string/settings_clear_current_playlist_confirmation_off"
            android:summaryOn="@string/settings_clear_current_playlist_confirmation_on"
            android:title="@string/settings_clear_current_playlist_confirmation"/>

        <ListPreference
            android:key="squeezer.customize_home_menu.mode"
            android:title="@string/settings_customize_home_menu_mode"
            android:dialogTitle="@string/settings_customize_home_menu_info"
            android:summary="%s"/>
        <ListPreference
            android:key="squeezer.customize_shortcut.mode"
            android:title="@string/settings_customize_customShortcut_mode"
            android:dialogTitle="@string/settings_customize_customShortcut_info"
            android:summary="%s"/>

        <ListPreference
            android:key="squeezer.action.onswipe.right"
            android:title="@string/settings_swipe_right_action"
            android:dialogTitle="@string/settings_swipe_right_action_summary"
            android:summary="%s"/>
        <ListPreference
            android:key="squeezer.action.onswipe.left"
            android:title="@string/settings_swipe_left_action"
            android:dialogTitle="@string/settings_swipe_left_action_summary"
            android:summary="%s"/>
    </PreferenceScreen>

    <!-- Control & remotes (this phone and third-party apps) ............. -->

    <PreferenceScreen
        android:key="squeezer.leaf.localplayer"
        android:title="@string/pref_cat_local_player">

        <SwitchPreferenceCompat
            android:key="squeezer.localplayer.enabled"
            android:defaultValue="true"
            android:summary="@string/settings_local_player_summary"
            android:title="@string/settings_local_player_title"/>

        <EditTextPreference
            android:key="squeezer.localplayer.name"
            android:dependency="squeezer.localplayer.enabled"
            android:summary="@string/settings_local_player_name_summary"
            android:title="@string/settings_local_player_name_title"/>

        <ListPreference
            android:key="squeezer.localplayer.quality.wifi"
            android:dependency="squeezer.localplayer.enabled"
            android:summary="%s"
            android:title="@string/settings_local_player_quality_wifi_title"/>

        <ListPreference
            android:key="squeezer.localplayer.quality.mobile"
            android:dependency="squeezer.localplayer.enabled"
            android:summary="%s"
            android:title="@string/settings_local_player_quality_mobile_title"/>
    </PreferenceScreen>

    <PreferenceScreen
        android:key="squeezer.leaf.thirdparty"
        android:title="@string/pref_cat_third_party">

        <SwitchPreferenceCompat
            android:key="squeezer.scrobble.enabled"
            android:summaryOff="@string/settings_scrobble_off"
            android:summaryOn="@string/settings_scrobble_on"
            android:title="@string/settings_scrobble_title"/>

        <SwitchPreferenceCompat
            android:key="squeezer.squeezeplayer.enabled"
            android:summary="@string/settings_squeezeplayer_summary"
            android:title="@string/settings_squeezeplayer_title"/>

        <SwitchPreferenceCompat
            android:key="squeezer.squeezelite.enabled"
            android:summary="@string/settings_squeezelite_summary"
            android:title="@string/settings_squeezelite_title"/>
    </PreferenceScreen>

    <!-- LyrPlay is for an iPhone or iPad: a QR code to scan, nothing else. -->
    <PreferenceScreen
        android:key="squeezer.leaf.lyrplay"
        android:title="@string/appliance_section_lyrplay">

        <Preference
            android:key="squeezer.lyrplay.open"
            android:icon="@drawable/ic_qr_code_scanner"
            android:title="@string/appliance_section_lyrplay"
            android:summary="@string/appliance_section_lyrplay_desc"/>
    </PreferenceScreen>

    <!-- Network & access .............................................. -->

    <PreferenceScreen
        android:key="squeezer.leaf.connection"
        android:title="@string/settings_tile_network">

        <!-- How the app reaches the server, including from outside the house. -->
        <Preference
            android:key="squeezer.server_address.open"
            android:icon="@drawable/ic_dns"
            android:title="@string/settings_server_address_title"/>

        <EditTextPreference
            android:key="squeezer.remote_address"
            android:icon="@drawable/ic_globe"
            android:title="@string/settings_remote_address_title"
            android:summary="@string/settings_remote_address_summary"/>
    </PreferenceScreen>

    <!-- System & updates .............................................. -->

    <!-- Hidden at run time when the appliance can't answer. -->
    <PreferenceScreen
        android:key="squeezer.leaf.timezone"
        android:title="@string/appliance_section_timezone">

        <Preference
            android:key="squeezer.timezone.open"
            android:icon="@drawable/ic_globe"
            android:title="@string/appliance_section_timezone"
            android:summary="@string/appliance_section_timezone_desc"/>
    </PreferenceScreen>

</PreferenceScreen>
